{
    "name": "jw-1980/ratings-and-reviews",
    "description": "Ratings, reviews per topic, threaded discussions, votes and moderation for Laravel applications.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "reviews",
        "ratings",
        "comments",
        "discussions",
        "moderation"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "symfony/html-sanitizer": "^7.2 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "RatingsAndReviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RatingsAndReviews\\Tests\\": "tests/",
            "RatingsAndReviews\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RatingsAndReviews\\RatingsAndReviewsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
