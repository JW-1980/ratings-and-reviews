{
    "name": "@jw-1980/ratings-and-reviews-vue",
    "version": "0.1.0",
    "description": "Vue 3 components for the jw-1980/ratings-and-reviews Laravel package: rating summary, reviews, review form, discussion and a Tiptap editor.",
    "license": "UNLICENSED",
    "private": false,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/ratings-and-reviews-vue.js",
    "module": "./dist/ratings-and-reviews-vue.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ratings-and-reviews-vue.js"
        },
        "./style.css": "./dist/ratings-and-reviews-vue.css",
        "./themes/welzolekker.css": "./dist/themes/welzolekker.css",
        "./themes/nutricompare.css": "./dist/themes/nutricompare.css"
    },
    "scripts": {
        "sync-shared": "node scripts/sync-shared.mjs",
        "pretest": "node scripts/sync-shared.mjs",
        "test": "vitest run",
        "pretypecheck": "node scripts/sync-shared.mjs",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "prebuild": "node scripts/sync-shared.mjs",
        "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-themes.mjs"
    },
    "peerDependencies": {
        "@tiptap/core": "~3.31.0",
        "@tiptap/extension-image": "~3.31.0",
        "@tiptap/pm": "~3.31.0",
        "@tiptap/starter-kit": "~3.31.0",
        "dompurify": "^3.0.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@tiptap/core": "3.31.4",
        "@tiptap/extension-image": "3.31.4",
        "@tiptap/pm": "3.31.4",
        "@tiptap/starter-kit": "3.31.4",
        "@types/node": "22.19.1",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "dompurify": "3.4.17",
        "jsdom": "30.1.3",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.1.0",
        "vue": "3.5.44",
        "vue-tsc": "3.3.14"
    },
    "engines": {
        "node": ">=22"
    }
}
