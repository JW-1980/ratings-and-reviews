{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "noImplicitAny": false,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "types": ["vitest/globals"],
        "jsx": "preserve",
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "tests/**/*.ts"]
}
